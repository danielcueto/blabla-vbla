# Base URL for the API (using local machine IP)
REACT_NATIVE_API_BASE_URL=http://192.168.1.10:3000

# Development URLs for Android emulator / iOS simulator
DEVELOPMENT_ANDROID_API_BASE_URL=http://192.168.1.10:3000
DEVELOPMENT_IOS_API_BASE_URL=http://192.168.1.10:3000

# Application environment: development | production
NODE_ENV=development

# Request timeouts (in milliseconds)
REQUEST_TIMEOUT=15000
CAMERA_SNAPSHOT_TIMEOUT=8000
ASYNC_OP_TIMEOUT=8000

# Camera snapshot quality (0–100)
SNAPSHOT_QUALITY=100

# Gallery picker timeout (ms)
GALLERY_PICK_TIMEOUT_MS=3000

# Size (px) for edge buttons
EDGE_BUTTON_SIZE=48

# Controls vertical offset ratio (0–1)
CONTROLS_VERTICAL_OFFSET_RATIO=0.08